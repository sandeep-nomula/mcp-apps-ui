{
  "name": "fx-rfq-mcp-app",
  "version": "1.0.0",
  "scripts": {
    "build:ui": "vite build --config vite.ui.config.ts",
    "build:host": "vite build --config vite.host.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:host && npm run build:server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/server/index.js",
    "start:stdio": "node dist/server/server/index.js --stdio",
    "dev": "tsx watch src/server/index.ts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "license": "ISC",
  "description": "MCP App: request streaming FX quotes from multiple banks and accept them inline in Claude",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "private": true
}
